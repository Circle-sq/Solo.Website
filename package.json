  "scripts": {
    "prepare:husky": "[ -d '.git' ] && [ ! -d '.git/hooks' ] &&  husky install || true",
    "preprepare:playwright": "echo CI=\"$CI\"",
    "prepare:playwright": "[ \"$CI\" = \"true\" ] && playwright install || true",
    "prepare": "npm-run-all prepare:*",
    "dev:standalone": "STANDALONE=true npm run dev",
    "dev": "NODE_ENV=development npm run check_all && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development nodemon --watch './src_server' --watch '.env' ./src_server/server.ts",
    "dev:client": "NODE_ENV=development vite --host",
    "build": "NODE_ENV=production npm run build:server && concurrently \"npm run build:client\" \"node ./node_task/meta-build.js\"",
    "build:standalone": "STANDALONE=true npm run build",
    "build:client": "NODE_ENV=production vite build",
    "build:server": "vite build -c vite.server.config.mts",
    "bundle-visualize": "vite-bundle-visualizer -c vite.config.mts -o ./build/stats.html",
    "start": "NODE_ENV=production node build/server/server.js",
    "start:prod:local:inspect": "npm run start:prod:local -- --inspect",
    "start:prod:local:trace": "npm run start:prod:local -- --trace-deprecation ",
    "start:prod:local": "NODE_ENV=production node build/server/server.js",
    "start:dev": "./start/solo_dev.sh",
    "start_with_inspect": "node --inspect build/server/server.js",
    "start_dev_watch": "NODE_ENV=development npm run check_all && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "auth:codeartifact": "./auth-codeartifact.sh",
    "check_all": "npm run check_env_variables",
    "check_env_variables": "ts-node ./node_task/check_env_variables.ts",
    "clean": "rimraf build",
    "deep-clean": "./node_task/clean-all.sh",
    "reinstall": "npm run deep-clean && npm ci && npx playwright install --with-deps",
    "nx-lint": "nx run-many -t lint --exclude=sportsbook",
    "lint": "npm-run-all --serial eslint:errors prettier:check ts-check nx-lint",
    "lint:old": "npm run prettier:check && npm run eslint:errors && npm run ts-check",
    "lint:nx-migration": "eslint --config ./eslint.nx-migration.config.mjs src/features  --quiet",
    "eslint": "eslint \"./src/**/*.{js,jsx,ts,tsx}\" \"./src_server/**/*.{js,jsx,ts,tsx}\"",
    "eslint:errors": "npm run eslint -- --max-warnings 2500 --quiet",
    "eslint:fix": "npm run eslint -- --fix",
    "preinstall": "npm --version",
    "postinstall": "npm run prepare",
    "prettier": "prettier \"./src/**/*.{js,jsx,ts,tsx}\" \"./src_server/**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "npm run prettier -- --write",
    "prettier:check": "npm run prettier -- --check",
    "ts-check": "tsc -p ./tsconfig.json",
    "ts-check:watch": "tsc -p ./tsconfig.json --watch",
    "generate_languages": "ts-node ./node_task/generate_languages.ts ",
    "test": "npm-run-all --parallel test:warning-guardian test:components",
    "test:warning-guardian": "node tests/test-runner.js",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "copy:lib": "cp -R ../solo-frontend-api/{lib,dist} node_modules/@solo/solo-frontend-api/",
    "watch:lib": "copy-and-watch --watch ../solo-frontend-api/{lib,dist} node_modules/@solo/solo-frontend-api/",
    "test:unit": "vitest --run",
    "test:unit:coverage": "npm run test:unit -- --coverage",
    "test:pr:develop": "vitest --coverage.enabled --changed=origin/develop --run",
    "build-storybook": "npx nx run ui-beteast:build-storybook",
    "test:components": "playwright test -c playwright-ct.config.mts",
    "test-ct": "npm run test:components"
  },
  "author": "Dawid Rusnak <dawid.rusnak@grandparade.co.uk>",
