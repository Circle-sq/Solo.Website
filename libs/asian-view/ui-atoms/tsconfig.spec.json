{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "types": [
      "@testing-library/jest-dom",
      "vitest",
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
    ]
  },
  "include": [
    "vite.config.mts",
    "vitest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.d.ts",
    "../../../tests/vitest.d.ts"
  ]
}
